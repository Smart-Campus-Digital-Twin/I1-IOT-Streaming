# Copy this file to .env and fill in real values before running.

MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_KEEPALIVE=60
MQTT_SUBSCRIBE_TOPIC=campus/#

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_PROCESSOR_GROUP_ID=campus-processor
KAFKA_ANALYTICS_GROUP_ID=campus-analytics

INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=<change-me>
INFLUXDB_ORG=smart-campus
INFLUXDB_BUCKET=sensors
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=<change-me>
INFLUXDB_BATCH_SIZE=200
INFLUXDB_FLUSH_INTERVAL_MS=1000

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=campus_metadata
POSTGRES_USER=campus_user
POSTGRES_PASSWORD=<change-me>

PUBLISH_INTERVAL_S=5.0
ANOMALY_EVERY_N=200

Z_SCORE_THRESHOLD=3.5
LOG_LEVEL=INFO
